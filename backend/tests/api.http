# ==============================================================================
# HEALTH ENDPOINTS
# ==============================================================================

### Health Check
GET http://127.0.0.1:8000/api/health

### Info Endpoint
GET http://127.0.0.1:8000/api/info


# ==============================================================================
# ERROR HANDLING TESTS
# ==============================================================================

### Test unhandled exception (should return 500 with consistent format)
GET http://127.0.0.1:8000/api/test-error

### Test NotFoundException (should return 404 with consistent format)
GET http://127.0.0.1:8000/api/test-not-found

### Test non-existent endpoint (should return 404)
GET http://127.0.0.1:8000/api/this-does-not-exist


# ==============================================================================
# AUTHENTICATION TESTS
# ==============================================================================

### No auth token — should return 401
GET http://127.0.0.1:8000/api/chat-sessions

### Invalid auth format — should return 401
GET http://127.0.0.1:8000/api/chat-sessions
Authorization: InvalidFormat token123

### Empty bearer token — should return 401
GET http://127.0.0.1:8000/api/chat-sessions
Authorization: Bearer 

### Valid auth token — should return 200
GET http://127.0.0.1:8000/api/chat-sessions
Authorization: Bearer any-token-works-for-now


# ==============================================================================
# CHAT SESSION ENDPOINTS
# ==============================================================================

### Get all chat sessions — with pagination defaults
GET http://127.0.0.1:8000/api/chat-sessions
Authorization: Bearer any-token-works-for-now

### Get all chat sessions — with custom pagination
GET http://127.0.0.1:8000/api/chat-sessions?limit=5&page=2
Authorization: Bearer any-token-works-for-now

### Get all chat sessions — with search
GET http://127.0.0.1:8000/api/chat-sessions?search=recursion&limit=10
Authorization: Bearer any-token-works-for-now

### Get all chat sessions — invalid limit (should return 422)
GET http://127.0.0.1:8000/api/chat-sessions?limit=500
Authorization: Bearer any-token-works-for-now

### Get all chat sessions — invalid page (should return 422)
GET http://127.0.0.1:8000/api/chat-sessions?page=0
Authorization: Bearer any-token-works-for-now

### Get single chat session
GET http://127.0.0.1:8000/api/chat-sessions/abc123
Authorization: Bearer any-token-works-for-now


# ==============================================================================
# CHAT SESSION CREATION
# ==============================================================================

### Create session — with title
POST http://127.0.0.1:8000/api/chat-sessions
Content-Type: application/json
Authorization: Bearer any-token-works-for-now

{
  "title": "Data Structures Study Session"
}

### Create session — without title (optional field)
POST http://127.0.0.1:8000/api/chat-sessions
Content-Type: application/json
Authorization: Bearer any-token-works-for-now

{}

### Create session — no auth (should return 401)
POST http://127.0.0.1:8000/api/chat-sessions
Content-Type: application/json

{
  "title": "Data Structures Study Session"
}


# ==============================================================================
# CHAT MESSAGES
# ==============================================================================

### Get messages for a session
GET http://127.0.0.1:8000/api/chat-sessions/abc123/messages
Authorization: Bearer any-token-works-for-now

### Get messages with custom limit
GET http://127.0.0.1:8000/api/chat-sessions/abc123/messages?limit=5
Authorization: Bearer any-token-works-for-now

### Send a valid message
POST http://127.0.0.1:8000/api/chat-sessions/abc123/messages
Content-Type: application/json
Authorization: Bearer any-token-works-for-now

{
  "content": "Explain recursion in simple English."
}

### Send a long message
POST http://127.0.0.1:8000/api/chat-sessions/abc123/messages
Content-Type: application/json
Authorization: Bearer any-token-works-for-now

{
  "content": "I need help understanding linked lists. Can you explain what a linked list is, how it differs from an array, when to use each one, and provide a simple Python implementation with comments explaining each line?"
}

### Send empty message — should return 422
POST http://127.0.0.1:8000/api/chat-sessions/abc123/messages
Content-Type: application/json
Authorization: Bearer any-token-works-for-now

{
  "content": ""
}

### Send message with no body — should return 422
POST http://127.0.0.1:8000/api/chat-sessions/abc123/messages
Content-Type: application/json
Authorization: Bearer any-token-works-for-now

{}

### Send message with no content field — should return 422
POST http://127.0.0.1:8000/api/chat-sessions/abc123/messages
Content-Type: application/json
Authorization: Bearer any-token-works-for-now

{
  "wrong_field": "this should fail"
}

### Send message — no auth (should return 401)
POST http://127.0.0.1:8000/api/chat-sessions/abc123/messages
Content-Type: application/json

{
  "content": "Explain recursion in simple English."
}


# ==============================================================================
# DELETE SESSION
# ==============================================================================

### Delete a session — with auth
DELETE http://127.0.0.1:8000/api/chat-sessions/abc123
Authorization: Bearer any-token-works-for-now

### Delete a session — no auth (should return 401)
DELETE http://127.0.0.1:8000/api/chat-sessions/abc123


# ==============================================================================
# SESSION SUMMARY
# ==============================================================================

### Get summary — default format (brief)
GET http://127.0.0.1:8000/api/chat-sessions/abc123/summary
Authorization: Bearer any-token-works-for-now

### Get summary — detailed format
GET http://127.0.0.1:8000/api/chat-sessions/abc123/summary?format=detailed
Authorization: Bearer any-token-works-for-now

### Get summary — invalid format (should return 422)
GET http://127.0.0.1:8000/api/chat-sessions/abc123/summary?format=nonsense
Authorization: Bearer any-token-works-for-now

### Get summary — no auth (should return 401)
GET http://127.0.0.1:8000/api/chat-sessions/abc123/summary


# ==============================================================================
# DOCUMENTS
# ==============================================================================

### List documents — with auth
GET http://127.0.0.1:8000/api/documents
Authorization: Bearer any-token-works-for-now

### List documents — no auth (if protected later)
GET http://127.0.0.1:8000/api/documents


# ==============================================================================
# CORS PREFLIGHT TEST
# ==============================================================================

### Simulate browser preflight request
OPTIONS http://127.0.0.1:8000/api/chat-sessions
Origin: http://localhost:3000
Access-Control-Request-Method: POST
Access-Control-Request-Headers: Authorization, Content-Type


# ==============================================================================
# RESPONSE HEADER VERIFICATION
# ==============================================================================
# After running any request above, check response headers for:
#
#   X-Request-ID: <uuid>           ← unique request identifier
#   X-Process-Time: <milliseconds> ← request processing duration
#
# These are added by RequestLoggingMiddleware
# ==============================================================================